    "Adds a 30 minute event to your default calendar.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un événement de 30 minutes à votre calendrier par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un evento de 30 minutos a tu calendario predeterminado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的默认日历中添加一个 30 分钟的事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的預設行事曆中加入一個 30 分鐘的事件。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਮੂਲ ਕੈਲੰਡਰ ਵਿੱਚ 30 ਮਿੰਟ ਦਾ ਇਵੈਂਟ ਜੋੜਦਾ ਹੈ।"
          }
        }
      }
    },
    "Adds a reminder to your default Reminders list.": {
      "extractionState": "manual",
      "localizations": {
