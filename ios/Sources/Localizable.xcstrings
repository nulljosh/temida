    "Usually the parties, like Smith v. Acme. One brief per matter.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généralement les parties, par exemple Dupont c. Acme. Un dossier par affaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente las partes, como Pérez c. Acme. Un expediente por asunto."
