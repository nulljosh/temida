    "%@ has no default list to add to.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas de liste par défaut où ajouter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene una lista predeterminada donde añadir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有可添加的默认列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」沒有可加入的預設列表。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਵਿੱਚ ਜੋੜਨ ਲਈ ਕੋਈ ਮੂਲ ਸੂਚੀ ਨਹੀਂ ਹੈ।"
          }
        }
      }
    },
