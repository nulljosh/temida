    "Use + to add a fact, a deadline, a witness or a ground.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez + pour ajouter un fait, une échéance, un témoin ou un motif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa + para añadir un hecho, un plazo, un testigo o un fundamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 + 添加事实、期限、证人或理由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 + 新增事實、期限、證人或理由。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੱਥ, ਆਖਰੀ ਮਿਤੀ, ਗਵਾਹ ਜਾਂ ਆਧਾਰ ਜੋੜਨ ਲਈ + ਵਰਤੋ।"
          }
        }
      }
    },
    "No money figures yet": {
      "extractionState": "manual",
      "localizations": {
