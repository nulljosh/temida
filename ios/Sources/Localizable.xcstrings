    "Your name shows on your profile. You can change it later.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom apparaît sur votre profil. Vous pourrez le modifier plus tard."
          }
