          }
        }
      }
    },
    "This changed on another device. Reopen the case and try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci a changé sur un autre appareil. Rouvrez le dossier et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cambió en otro dispositivo. Vuelve a abrir el caso e inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容已在另一台设备上更改。请重新打开案件后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內容已在另一台裝置上變更。請重新開啟案件後再試。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਕਿਸੇ ਹੋਰ ਡਿਵਾਈਸ ਤੇ ਬਦਲ ਗਿਆ। ਕੇਸ ਦੁਬਾਰਾ ਖੋਲ੍ਹੋ ਅਤੇ ਫਿਰ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        }
      }
    },
