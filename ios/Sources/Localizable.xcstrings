        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常是当事人，例如“张某诉 Acme”。每个事项一份简报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通常是當事人，例如「張某訴 Acme」。每個事項一份簡報。"
          }
